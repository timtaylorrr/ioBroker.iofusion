{
	"common": {
		"name": "iofusion",
		"version": "0.1.0",
		"news": {
			"0.1.0": { "en": "Initial version", "de": "Erste Version" }
		},
		"title": "ioFusion",
		"titleLang": { "en": "ioFusion", "de": "ioFusion" },
		"desc": {
			"en": "Modern drag-and-drop dashboard for ioBroker, based on ha-fusion",
			"de": "Modernes Drag-and-drop-Dashboard für ioBroker, basierend auf ha-fusion"
		},
		"authors": ["ioFusion contributors"],
		"keywords": ["dashboard", "visualization", "ha-fusion"],
		"license": "MIT",
		"licenseInformation": { "license": "MIT", "type": "free" },
		"platform": "Javascript/Node.js",
		"mode": "daemon",
		"type": "visualization",
		"compact": false,
		"connectionType": "local",
		"dataSource": "push",
		"adminUI": { "config": "json" },
		"tier": 3,
		"dependencies": [{ "js-controller": ">=5.0.19" }],
		"globalDependencies": [{ "admin": ">=6.17.14" }]
	},
	"native": {
		"port": 8095,
		"bind": "0.0.0.0",
		"include": "*"
	},
	"objects": [],
	"instanceObjects": [
		{
			"_id": "info",
			"type": "channel",
			"common": { "name": "Information" },
			"native": {}
		},
		{
			"_id": "info.connection",
			"type": "state",
			"common": {
				"role": "indicator.connected",
				"name": "Web server running",
				"type": "boolean",
				"read": true,
				"write": false,
				"def": false
			},
			"native": {}
		}
	]
}
